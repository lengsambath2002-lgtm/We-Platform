# Copy to .env (never commit .env). Used by docker-compose.yml.
DATABASE_PASSWORD=change-me
# openssl rand -base64 48
PLATFORM_JWT_SECRET=
# local | production. Production also needs PLATFORM_COOKIE_SECURE=true and an https PLATFORM_APP_URL.
PLATFORM_ENV=local
PLATFORM_COOKIE_SECURE=false
PLATFORM_APP_URL=http://localhost:3300
# Email (invitations, password resets). Leave PLATFORM_MAIL_HOST empty to only log emails.
PLATFORM_MAIL_HOST=
PLATFORM_MAIL_PORT=587
PLATFORM_MAIL_USERNAME=
PLATFORM_MAIL_PASSWORD=
PLATFORM_MAIL_FROM=Business Platform <no-reply@example.com>
# starttls | ssl | none
PLATFORM_MAIL_SECURITY=starttls
# Development: only these addresses (comma-separated) get real email; others are logged.
PLATFORM_MAIL_ONLY_TO=
# Single sign-on for VirtualBiz (see README). Base64 of a PKCS#8 PEM RSA key:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 | tr -d '\n'
PLATFORM_OIDC_SIGNING_KEY=
# JSON array of clients; secretHash = SHA-256 hex of the client secret (printf %s "$SECRET" | shasum -a 256)
PLATFORM_OIDC_CLIENTS=
# VirtualBiz web origin; the Retail & Commerce module is available only when set.
PLATFORM_VIRTUALBIZ_URL=
