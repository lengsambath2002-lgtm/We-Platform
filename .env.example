# Copy to .env (never commit .env). Used by docker-compose.yml.
DATABASE_PASSWORD=change-me
# openssl rand -base64 48
PLATFORM_JWT_SECRET=
# local | production. Production also needs PLATFORM_COOKIE_SECURE=true and an https PLATFORM_APP_URL.
PLATFORM_ENV=local
PLATFORM_COOKIE_SECURE=false
PLATFORM_APP_URL=http://localhost:3300
